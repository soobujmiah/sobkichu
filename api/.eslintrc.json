{
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "project": "tsconfig.json",
    "sourceType": "module"
  },
  "plugins": [
    "@typescript-eslint"
  ],
  "extends": [
    "plugin:@typescript-eslint/recommended",
    "plugin:prettier/recommended"
  ],
  "root": true,
  "env": {
    "node": true,
    "jest": true
  },
  "ignorePatterns": [
    ".eslintrc.json",
    "dist",
    "node_modules"
  ],
  "rules": {
    "@typescript-eslint/interface-name-prefix": "off",
    "@typescript-eslint/explicit-function-return-type": "off",
    "@typescript-eslint/explicit-module-boundary-types": "off",
    "@typescript-eslint/no-explicit-any": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "../identity/**",
              "../../identity/**",
              "src/identity/**",
              "../location/**",
              "../../location/**",
              "src/location/**",
              "../catalog/**",
              "../../catalog/**",
              "src/catalog/**",
              "../order/**",
              "../../order/**",
              "src/order/**",
              "../payment/**",
              "../../payment/**",
              "src/payment/**",
              "../notification/**",
              "../../notification/**",
              "src/notification/**",
              "../admin/**",
              "../../admin/**",
              "src/admin/**",
              "../dispatch/**",
              "../../dispatch/**",
              "src/dispatch/**",
              "../ledger/**",
              "../../ledger/**",
              "src/ledger/**",
              "../community/**",
              "../../community/**",
              "src/community/**"
            ],
            "message": "Cross-module import. Modules must not reach into each other's internals (docs/architecture/backend-modules.md, boundary rule 1). Depend on a port in src/common/ports/ instead. src/common/ is shared infrastructure and is always allowed."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/*.module.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../identity/*.service",
                  "../identity/*.repository",
                  "../identity/*.adapter",
                  "../identity/*.controller",
                  "../identity/domain/**",
                  "../identity/dto/**",
                  "../location/*.service",
                  "../location/*.repository",
                  "../location/*.adapter",
                  "../location/*.controller",
                  "../location/domain/**",
                  "../location/dto/**",
                  "../catalog/*.service",
                  "../catalog/*.repository",
                  "../catalog/*.adapter",
                  "../catalog/*.controller",
                  "../catalog/domain/**",
                  "../catalog/dto/**",
                  "../order/*.service",
                  "../order/*.repository",
                  "../order/*.adapter",
                  "../order/*.controller",
                  "../order/domain/**",
                  "../order/dto/**",
                  "../payment/*.service",
                  "../payment/*.repository",
                  "../payment/*.adapter",
                  "../payment/*.controller",
                  "../payment/domain/**",
                  "../payment/dto/**",
                  "../notification/*.service",
                  "../notification/*.repository",
                  "../notification/*.adapter",
                  "../notification/*.controller",
                  "../notification/domain/**",
                  "../notification/dto/**",
                  "../admin/*.service",
                  "../admin/*.repository",
                  "../admin/*.adapter",
                  "../admin/*.controller",
                  "../admin/domain/**",
                  "../admin/dto/**",
                  "../dispatch/*.service",
                  "../dispatch/*.repository",
                  "../dispatch/*.adapter",
                  "../dispatch/*.controller",
                  "../dispatch/domain/**",
                  "../dispatch/dto/**",
                  "../ledger/*.service",
                  "../ledger/*.repository",
                  "../ledger/*.adapter",
                  "../ledger/*.controller",
                  "../ledger/domain/**",
                  "../ledger/dto/**",
                  "../community/*.service",
                  "../community/*.repository",
                  "../community/*.adapter",
                  "../community/*.controller",
                  "../community/domain/**",
                  "../community/dto/**"
                ],
                "message": "A module may import another module's *.module.ts for DI wiring, but not its services, repositories, adapters, controllers, domain or DTOs. Bind a port in src/common/ports/ instead."
              }
            ]
          }
        ]
      }
    }
  ]
}
