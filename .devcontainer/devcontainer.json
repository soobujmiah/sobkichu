{
  "name": "Sobkichu — Flutter + Node + PostGIS + Redis",
  "dockerComposeFile": "docker-compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/sobkichu",

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "installGradle": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "forwardPorts": [3000, 5432, 6379],
  "portsAttributes": {
    "3000": { "label": "API (NestJS)", "onAutoForward": "notify" },
    "5432": { "label": "PostgreSQL + PostGIS", "onAutoForward": "silent" },
    "6379": { "label": "Redis", "onAutoForward": "silent" }
  },

  "containerEnv": {
    "DATABASE_URL": "postgresql://sobkichu:sobkichu@db:5432/sobkichu",
    "REDIS_URL": "redis://cache:6379",
    "FLUTTER_ROOT": "/opt/flutter",
    "PATH": "/opt/flutter/bin:/opt/flutter/bin/cache/dart-sdk/bin:${PATH}"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "bierner.markdown-mermaid"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "files.insertFinalNewline": true,
        "files.trimTrailingWhitespace": true
      }
    }
  },

  "remoteUser": "vscode"
}
