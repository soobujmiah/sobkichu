# Sobkichu — environment template.
#
# Master prompt Section 4: GitHub Actions secrets and repo-level environment
# configuration are the PRIMARY mechanism. This file documents which keys
# exist; it holds no values and must never hold real ones.
#
# A committed .env with real secrets is a security incident, not a shortcut.
# .env is gitignored. In Codespaces, post-create.sh copies this to .env.

# --- Datastores (devcontainer defaults; overridden in CI) --------------------
DATABASE_URL=postgresql://sobkichu:sobkichu@db:5432/sobkichu
REDIS_URL=redis://cache:6379

# --- Payments ----------------------------------------------------------------
# Licensed aggregator only. We never hold customer funds — see
# docs/adr/0004-payments-via-licensed-aggregator.md
PAYMENT_AGGREGATOR=sslcommerz
PAYMENT_AGGREGATOR_KEY=
PAYMENT_AGGREGATOR_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Escrow unlocks 100% advance payment (compliance C3), and may only point at
# a Bangladesh Bank-approved provider. Needs legal sign-off before enabling.
ESCROW_PROVIDER=
ESCROW_ENABLED=false

# --- Notifications -----------------------------------------------------------
# SMS is mandatory alongside push, not a fallback for push failure
# (master prompt Section 8).
SMS_GATEWAY_URL=
SMS_GATEWAY_KEY=
SMS_SENDER_ID=
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# --- Authentication ----------------------------------------------------------
# HMAC secret for hashing OTP codes at rest. A bare hash of a 6-digit code is
# reversible by brute force; this is what makes a stolen hash useless.
OTP_SECRET=

# HMAC secret for session tokens. Rotating it invalidates every session.
SESSION_SECRET=

# --- Identity / KYC ----------------------------------------------------------
# NID verification gates merchant publishing (compliance K1).
NID_VERIFY_API_URL=
NID_VERIFY_API_KEY=

# BRTA licence/vehicle verification — Phase 2, rider mode.
BRTA_VERIFY_API_URL=
BRTA_VERIFY_API_KEY=

# --- Media -------------------------------------------------------------------
# Aggressive compression at upload time: bandwidth cost is a real constraint
# for BD users, not a nice-to-have.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# --- Feature flags -----------------------------------------------------------
# Phase 1 is the active scope. Later-phase modules ship dark.
FEATURE_RIDER_DISPATCH=false
FEATURE_DIGITAL_KHATA=false
FEATURE_PROFESSIONAL_MODE=false
FEATURE_COMMUNITY_HUB=false

# --- App ---------------------------------------------------------------------
NODE_ENV=development
PORT=3000
DEFAULT_LANGUAGE=bn
DEFAULT_SEARCH_RADIUS_KM=5
